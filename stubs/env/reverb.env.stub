# Laravel Reverb uses three different hosts. Mixing them up is the most common Reverb failure.
#
# 1. Bind address: where the Reverb server listens. 0.0.0.0 means every interface of the
#    container; nobody connects to it.
# 2. Publish target: where the application sends broadcasts, over the internal network.
# 3. Public host: what the browser connects to, through the reverse proxy and TLS.

# --- Reverb server (the container running php artisan reverb:start) ---
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT={{ upstream_port }}
REVERB_SERVER_PATH={{ path }}

# --- Application (publishes broadcasts to Reverb on the internal network) ---
REVERB_HOST={{ upstream_host }}
REVERB_PORT={{ upstream_port }}
REVERB_SCHEME=http

# --- Frontend (baked into the browser bundle at build time) ---
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST={{ public_host }}
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
